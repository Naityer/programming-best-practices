{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/programming-best-practices/design-patterns/catalog.schema.json",
  "title": "Design Pattern Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patterns"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "family", "roles", "required_relations", "conflicts_with"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "family": {"enum": ["creational", "structural", "behavioral"]},
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required_relations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "behavioral_signals": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "conflicts_with": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "opportunity_signal": {"type": "string"}
        }
      }
    }
  }
}
