{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "catalog_version", "policy", "families", "algorithms"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_version": {"type": "string"},
    "policy": {"type": "object"},
    "families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "algorithms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "tier", "problem", "preconditions", "contraindications", "complexity", "memory", "exactness", "stability", "alternatives", "common_misuses", "recipes", "standard_mappings", "references"],
        "properties": {
          "id": {"type": "string"}, "family": {"type": "string"},
          "tier": {"type": "integer", "minimum": 1, "maximum": 3},
          "problem": {"type": "string"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "contraindications": {"type": "array", "items": {"type": "string"}},
          "complexity": {"type": "object"}, "memory": {"type": "string"},
          "exactness": {"type": "string"}, "stability": {"type": "string"},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "common_misuses": {"type": "array", "items": {"type": "string"}},
          "recipes": {"type": "array", "items": {"type": "object"}},
          "standard_mappings": {"type": "object"},
          "references": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
