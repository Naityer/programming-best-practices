{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/programming-best-practices/audit-result.schema.json",
  "title": "Programming Best Practices Audit Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit", "summary", "tools", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "profile", "scope", "mode", "generated_at", "outcome"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "profile": {"enum": ["fast", "standard", "deep"]},
        "scope": {"type": "string", "minLength": 1},
        "mode": {"enum": ["audit", "fix"]},
        "generated_at": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["pass", "fail", "incomplete", "informational"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_counts"],
      "properties": {
        "finding_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocker", "high", "medium", "low"],
          "properties": {
            "blocker": {"type": "integer", "minimum": 0},
            "high": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0},
            "low": {"type": "integer", "minimum": 0}
          }
        },
        "dimensions": {"type": "object"}
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "findings", "failed", "timed_out", "skipped", "unavailable"]},
          "command": {"type": "string"},
          "version": {"type": "string"},
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "report": {"type": "string"},
          "reason": {"type": "string"},
          "gate": {"type": "boolean"},
          "effective_scope": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "output_format": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fingerprint", "rule_id", "title", "category", "severity", "confidence", "locations", "evidence", "impact", "recommendation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocker", "high", "medium", "low"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file"],
              "properties": {
                "file": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "column": {"type": "integer", "minimum": 1}
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_type", "source", "message"],
              "properties": {
                "source_type": {"enum": ["tool", "specification", "property", "llm"]},
                "source": {"type": "string", "minLength": 1},
                "message": {"type": "string", "minLength": 1},
                "metric": {"type": "string"},
                "value": {}
              }
            }
          },
          "impact": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["regression", "specification", "property"]},
              "source": {"type": "string"},
              "rule": {"type": "string"}
            }
          }
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}



